[resource]
script = ExtResource("1")
id = &"niflheim"
display_name = "尼福尔海姆"
subtitle = "原雾冰川"
tree_domain = "root"
prerequisites = Array[StringName]([&"alfheim"])
required_lingua_node = &"world_trace"
